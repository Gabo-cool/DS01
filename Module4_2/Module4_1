#include <iostream>
#include <stack>
#include <vector>
#include <string>
using namespace std;

int main()
{
    string mystring;
    stack<int, vector<int>> iStack;
    int openBracesCounter = 0, closeBracesCounter = 0;

    cout << "Enter a string of braces: ";
    cin >> mystring;

    string result = mystring;

    for (int x = 0; x < mystring.size(); x++)
    {
        char currentChar = mystring[x];

        if (currentChar == '{')
        {
            openBracesCounter++;
        }
        else if (currentChar == '}')
        {
            closeBracesCounter++;
        }
        iStack.push(x);
    }

    int replacements = abs(openBracesCounter - closeBracesCounter) / 2;

    cout << "Open bracket: " << openBracesCounter << endl;
    cout << "Close bracket: " << closeBracesCounter << endl;
    cout << "Minimum of replacement required: " << replacements << endl;

    while (!iStack.empty()) iStack.pop();

    for (int x = 0; x < result.size(); x++)
    {
        if (result[x] == '{')
        {
            iStack.push(x);
        }
        else if (result[x] == '}')
        {
            if (!iStack.empty())
            {
                iStack.pop();
            }
            else
            {
                result[x] = '{';
                iStack.push(x);
            }
        }
    }

    while (!iStack.empty()) iStack.pop();

    for (int x = result.size() - 1; x >= 0; x--)
    {
        if (result[x] == '}')
        {
            iStack.push(x);
        }
        else if (result[x] == '{')
        {
            if (!iStack.empty())
            {
                iStack.pop();
            }
            else
            {
                result[x] = '}';
            }
        }
    }

    cout << "Original string: " << mystring << endl;

    for (int x = 0; x < mystring.size(); x++)
    {
        if (mystring[x] != result[x])
        {
            cout << "Position " << x + 1 << ": '" << mystring[x] << "' -> '" << result[x] << "'" << endl;
        }
    }

    return 0;
}
